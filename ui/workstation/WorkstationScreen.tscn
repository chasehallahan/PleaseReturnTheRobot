[node name="CodeEdit" type="CodeEdit" parent="MainSplit/WorkspaceSplit/EditorSplit/CodeEditor" unique_id=452743093]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
text = "-- Salvage routine / R-01
-- Leave enough power to get home.
local reserve = 25
local trips = 0
 
local function return_to_base()
    move(\"west\")
    unload()
    recharge()
end
 
while trips < 3 do
    move(\"east\")
    local room = scan()
 
    if room.salvage then
        while not cargo_full() do
            salvage()
            if battery() <= reserve then
                break
            end
        end
    end
 
    return_to_base()
    trips = trips + 1
end
 
print(\"Robot returned safely.\")"
symbol_tooltip_on_hover = true
gutters_draw_breakpoints_gutter = true
gutters_draw_executing_lines = true
gutters_draw_line_numbers = true
code_completion_enabled = true
indent_automatic = true
auto_brace_completion_enabled = true
auto_brace_completion_highlight_matching = true

